{
  "name": "adversarial-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "review-agent": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
